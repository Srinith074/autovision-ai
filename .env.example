# ==========================================
# AutoVision AI - Backend Environment Config
# ==========================================

# Port and Host bindings (Render automatically sets PORT)
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
# Note: Any *.vercel.app domain is automatically allowed by default
ALLOWED_ORIGINS=http://localhost:5173,https://autovision-ai.vercel.app

# YOLOv8 Deep Learning Model Weights Path or Name
# Defaults to models/yolov8n.pt (will auto-download from Ultralytics if missing)
MODEL_PATH=models/yolov8n.pt

# Maximum Video Upload Size Limit in Megabytes
MAX_UPLOAD_SIZE_MB=250
